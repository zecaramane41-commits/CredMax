{
  "name": "microcredit-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/routes/index.js && node --check src/middleware/permissions.js && node --check src/db/migrator.js",
    "db:export-schema": "node scripts/introspect-schema.js",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "nodemailer": "^9.0.6",
    "pg": "8.13.1",
    "zod": "^4.4.3"
  }
}
